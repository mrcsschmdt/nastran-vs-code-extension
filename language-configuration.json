{
  "comments": {
    "lineComment": "$"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["'", "'"]
  ],
  "wordPattern": "[+\\-]?[A-Za-z0-9_.]+(?:[+\\-][0-9]+)?\\*?"
}
